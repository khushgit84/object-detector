{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/models/(.*)",
      "destination": "/models/$1"
    },
    {
      "source": "/samples/(.*)",
      "destination": "/samples/$1"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
